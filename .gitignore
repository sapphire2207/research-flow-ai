# Python & Backend (FastAPI / LangGraph)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python Virtual Environments
.venv/
venv/
ENV/
env/
.venv*/

# Build & Cache Directories
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------
# Node.js & Frontend (Next.js 16)
# ------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# Next.js Build Output
.next/
out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# Vercel & TypeScript
.vercel/
*.tsbuildinfo

